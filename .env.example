# Copy to .env (gitignored). No scraping API keys are needed for the RSS/WebSearch-only source
# set -- every value below is optional and defaults to a safe, local value when unset.

# Overrides config.yaml's paper_db_path (see config.example.yaml). Point this at wherever your
# own read-only paper.db snapshot lives.
#MACRO_MONITOR_PAPER_DB_PATH=/var/lib/macro-monitor/paper.db

# Directory node-exporter's textfile collector reads from (see src/macro_monitor/metrics.py).
# Defaults to the upstream node_exporter convention.
#MACRO_MONITOR_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# Service account this repo's deploy.sh installs and runs under. Defaults to "macro-monitor".
#MACRO_MONITOR_SERVICE_USER=macro-monitor
