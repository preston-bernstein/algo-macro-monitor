# Copy to .env (gitignored). No scraping API keys are needed for the RSS/WebSearch-only source set.
# DESKTOP_AGENT_HOST is only relevant if the correlator is ever run from a remote host; on the
# desktop itself the correlator reads the local snapshot directly (see docs/DECISIONS.md, FR-17).
DESKTOP_AGENT_HOST=desktop-agent
# Fallback-only (see plan.md Technology choices); the primary review path is the schedule-skill agent turn.
LLM_GATEWAY_URL=http://127.0.0.1:4000
