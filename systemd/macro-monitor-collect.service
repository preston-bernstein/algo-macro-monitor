[Unit]
Description=Macro Context Monitor — daily RSS collection + read-only paper.db correlation
Documentation=https://github.com/preston-bernstein/internal-monitor-service
# The correlator reads the local snapshot at /srv/paper-share/paper.db (refreshed by
# paper-db-snapshot.timer). We do not hard-require that unit here — a missing/stale snapshot is a
# logged no-op for the day (FR-05 failure handling), never a crash.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=internal-monitor-service
Group=internal-monitor-service
WorkingDirectory=/home/internal-monitor-service/app
SyslogIdentifier=macro-monitor
# 1) deterministic RSS collection (FR-01, no LLM); 2) read-only paper.db correlation over a
# trailing window (FR-05/06/17/18/19). Previously this second line passed `--date
# "$(date -u +%%Y-%%m-%%d)"` -- an exact date the daily 06:30 UTC fire could never actually match,
# because raw_observations is stamped with each feed entry's own published date, which by 06:30
# UTC has not yet advanced to "today" for any US-business-hours source. That made correlate a
# permanent no-op in production (confirmed: correlations held 2 rows total, both from a one-off
# manual DECISIONS.md check, never from the timer). `correlate` with no --date now defaults to a
# trailing window (config's correlate_lookback_days) instead of one exact day -- see
# src/macro_monitor/correlator.py's observed_dates_since docstring for the full account.
ExecStart=/home/internal-monitor-service/app/.venv/bin/macro-monitor --config /home/internal-monitor-service/app/config.yaml collect-rss
ExecStart=/home/internal-monitor-service/app/.venv/bin/macro-monitor --config /home/internal-monitor-service/app/config.yaml correlate

# Hardening — this process ingests untrusted RSS content; keep its blast radius minimal.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Writable: the local log DB, generated reports, and the shared node-exporter textfile-collector
# directory this unit's .prom metrics land in (§18 -- a oneshot job can't be scraped, so metrics
# go out via the textfile collector on the way out). paper.db is read via /srv/paper-share (ro).
ReadWritePaths=/home/internal-monitor-service/app/data /home/internal-monitor-service/app/reports /opt/docker/observability/node-exporter-textfiles
ReadOnlyPaths=/srv/paper-share
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
